# Arc Testnet deploy. Do not commit a real key. Do not set these for mainnet.
USD_CONFIRM_TESTNET=YES
PRIVATE_KEY=
USD_ADMIN=
USD_TREASURY=
USD_TREASURY_CONTROLLER=

# RainbowKit WalletConnect. Injected wallets still load if this is empty, but WalletConnect needs a real id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
